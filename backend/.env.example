# Application Settings
APP_NAME="GMC Document Intelligence API"
APP_ENV="development"
DEBUG=true
PORT=8000

# LLM Provider Configuration (gemini, groq, mock)
LLM_PROVIDER="gemini"
MODEL_NAME="gemini-2.5-flash"

# Provider API Keys
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Vector Search / Retrieval Settings
EMBEDDING_MODEL="all-MiniLM-L6-v2"
TOP_K_CHUNKS=4

# Ingestion Settings
OCR_FALLBACK_MIN_TEXT_CHARS=30
MAX_UPLOAD_SIZE_MB=25
